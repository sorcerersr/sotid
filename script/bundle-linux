#!/usr/bin/env bash

set -euxo pipefail

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz for Linux.

Options:
  -h, --help        Display this help and exit.
  --flatpak         Set SOTID_BUNDLE_TYPE=flatpak so that this can be included in system info
  "
}

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export SOTID_BUNDLE_TYPE=flatpak
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

if [[ -n "${RUSTFLAGS+x}" || -n "${CARGO_ENCODED_RUSTFLAGS+x}" ]]; then
    echo "Unset RUSTFLAGS and CARGO_ENCODED_RUSTFLAGS; put extra flags in target rustflags in .cargo/config.toml so bundle flags are preserved." >&2
    exit 1
fi

export SOTID_BUNDLE=true

channel=$(<crates/sotid/RELEASE_CHANNEL)
target_dir="${CARGO_TARGET_DIR:-target}"

version="$(script/get-crate-version sotid)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

commit=$(git rev-parse HEAD | cut -c 1-7)

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }
musl_triple=${target_triple%-gnu}-musl
remote_server_triple=${REMOTE_SERVER_TARGET:-"${musl_triple}"}
rustup_installed=false
if command -v rustup >/dev/null 2>&1; then
    rustup_installed=true
fi

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

if "$rustup_installed"; then
    rustup target add "$remote_server_triple"
fi

export CC=${CC:-$(which clang)}
lld=${LLD:-$("$CC" -print-prog-name=ld.lld)}
if [[ "$lld" != /* || ! -x "$lld" ]]; then
    echo "Bundling requires an absolute executable linker path; set LLD (e.g. LLD=/usr/bin/ld.lld-18)." >&2
    exit 1
fi
lld_version=$("$lld" --version)
if [[ ! "$lld_version" =~ LLD\ ([0-9]+)\. ]] || (( BASH_REMATCH[1] < 12 )); then
    echo "Bundling requires LLD 12 or newer for safe ICF; set LLD to a supported linker (e.g. LLD=/usr/bin/ld.lld-18)." >&2
    exit 1
fi

# Build binary in release mode
cargo --config .cargo/bundle-config.toml rustc --release --target "${target_triple}" --package sotid --bin sotid -- -C linker="$CC" -C llvm-args=-addrsig -C link-arg=-fuse-ld=lld -C link-arg=--ld-path="$lld" -C link-arg=-Wl,--icf=safe
cargo --config .cargo/bundle-config.toml build --release --target "${target_triple}" --package cli
# Build remote_server in separate invocation to prevent feature unification from other crates
# from influencing dynamic libraries required by it.
if [[ "$remote_server_triple" == "$musl_triple" ]]; then
    musl_cc_var="CC_$(echo "$remote_server_triple" | tr '-' '_')"
    export "$musl_cc_var"=musl-gcc
fi
cargo --config .cargo/bundle-config.toml build --release --target "${remote_server_triple}" --package remote_server

# Split debug symbols into local .dbg files, then strip debug info and local
# symbols from the shipped binaries. The .dbg files keep symbols recoverable
# for post-mortem debugging.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
llvm-objcopy --only-keep-debug "${target_dir}/${target_triple}/release/sotid" "${target_dir}/${target_triple}/release/sotid.dbg"
llvm-objcopy --only-keep-debug "${target_dir}/${remote_server_triple}/release/remote-server" "${target_dir}/${remote_server_triple}/release/remote-server.dbg"

# Ensure that remote_server does not depend on libssl nor libcrypto, as we got rid of these deps.
if ldd "${target_dir}/${remote_server_triple}/release/remote-server" | grep -q 'libcrypto\|libssl'; then
    if [[ "$remote_server_triple" == *-musl ]]; then
        echo "Error: remote_server still depends on libssl or libcrypto" && exit 1
    else
        echo "Info: Using non-musl remote-server build."
    fi
fi

# Build the second Linux arch so the app ships a remote_server for both x86_64
# and aarch64 Linux remotes. The native arch is already built above; the
# non-native one is cross-compiled with cargo-zigbuild for uniformity across the
# bundle scripts.
host_arch=$(uname -m)
for linux_arch in x86_64 aarch64; do
    if [[ "$linux_arch" == "$host_arch" ]]; then
        continue
    fi
    linux_triple="${linux_arch}-unknown-linux-musl"
    if "$rustup_installed"; then
        rustup target add "$linux_triple"
    fi
    if ! command -v cargo-zigbuild >/dev/null 2>&1; then
        cargo install --locked cargo-zigbuild
    fi
    RUSTFLAGS="-C target-feature=+crt-static" \
        cargo --config .cargo/bundle-config.toml zigbuild --release --target "$linux_triple" --package remote_server
    llvm-objcopy --only-keep-debug "${target_dir}/${linux_triple}/release/remote-server" "${target_dir}/${linux_triple}/release/remote-server.dbg"
done

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory.
temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT
sotid_dir="${temp_dir}/sotid$suffix.app"

# Cargo may reuse its outputs on the next invocation. Strip packaging copies
# so reruns still extract complete debug companions.
mkdir -p "${sotid_dir}/bin" "${sotid_dir}/libexec"
llvm-objcopy --strip-unneeded "${target_dir}/${target_triple}/release/sotid" "${sotid_dir}/libexec/sotid-editor"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/cli" "${sotid_dir}/bin/sotid"

# Bundle the remote_server for both Linux archs so connecting to a Linux
# remote never requires a download or compile. Each is stripped, gzipped, and
# placed next to the editor in libexec/; the runtime resolves it via the
# executable's directory.
for linux_arch in x86_64 aarch64; do
    linux_triple="${linux_arch}-unknown-linux-musl"
    if [[ "$linux_triple" != "$remote_server_triple" ]]; then
        llvm-objcopy --strip-debug --discard-all "${target_dir}/${linux_triple}/release/remote-server" "${temp_dir}/remote_server_${linux_arch}"
    else
        llvm-objcopy --strip-debug --discard-all "${target_dir}/${remote_server_triple}/release/remote-server" "${temp_dir}/remote_server_${linux_arch}"
    fi
    gzip -f --stdout --best "${temp_dir}/remote_server_${linux_arch}" > "${target_dir}/sotid-remote-server-linux-${linux_arch}.gz"
    cp "${target_dir}/sotid-remote-server-linux-${linux_arch}.gz" "${sotid_dir}/libexec/"
done

# Fail the bundle if either Linux remote_server is missing from the app.
for linux_arch in x86_64 aarch64; do
    if [ ! -f "${sotid_dir}/libexec/sotid-remote-server-linux-${linux_arch}.gz" ]; then
        echo "Error: missing bundled remote_server sotid-remote-server-linux-${linux_arch}.gz" >&2
        exit 1
    fi
done

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/sotid |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${sotid_dir}/lib"
rm -rf "${sotid_dir}/lib/*"
cp $(find_libs) "${sotid_dir}/lib"

# Icons
mkdir -p "${sotid_dir}/share/icons/hicolor/512x512/apps"
cp "crates/sotid/resources/app-icon$suffix.png" "${sotid_dir}/share/icons/hicolor/512x512/apps/sotid.png"
mkdir -p "${sotid_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/sotid/resources/app-icon$suffix@2x.png" "${sotid_dir}/share/icons/hicolor/1024x1024/apps/sotid.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="sotid"
export APP_ICON="sotid"
export APP_ARGS="%U"
if [[ "$channel" == "preview" ]]; then
  export APP_NAME="Sotid Preview"
  APP_ID="de.sorcarion.Sotid-Preview"
elif [[ "$channel" == "nightly" ]]; then
  export APP_NAME="Sotid Nightly"
  APP_ID="de.sorcarion.Sotid-Nightly"
elif [[ "$channel" == "dev" ]]; then
  export APP_NAME="Sotid Devel"
  APP_ID="de.sorcarion.Sotid-Dev"
else
  export APP_NAME="Sotid"
  APP_ID="de.sorcarion.Sotid"
fi

mkdir -p "${sotid_dir}/share/applications"
envsubst < "crates/sotid/resources/sotid.desktop.in" > "${sotid_dir}/share/applications/$APP_ID.desktop"
chmod +x "${sotid_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${sotid_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="sotid-linux-${arch}.tar.gz"

rm -rf "${archive}"
remove_match="sotid(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czvf "${target_dir}/release/$archive" -C ${temp_dir} "sotid$suffix.app"
