name: sotid
title: Sotid
base: core24
version: "$RELEASE_VERSION"
summary: High-performance, offline code editor
description: |
  Sotid is a high-performance, offline code editor. It is a fork of Zed with
  all cloud connections (AI, collaboration, telemetry, update checks, extension
  marketplace) removed. Sotid keeps only project-related connections: git,
  package registries, language servers, and SSH remote development.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/sotid/sotid
source-code: https://github.com/sotid/sotid
issues: https://github.com/sotid/sotid/issues
contact: https://github.com/sotid/sotid

parts:
  sotid:
    plugin: dump
    source: "https://github.com/sotid/sotid/releases/download/v$RELEASE_VERSION/sotid-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Sotid exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Sotid exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  sotid:
    command: usr/bin/sotid
    common-id: dev.sotid.Sotid
    environment:
      SOTID_BUNDLE_TYPE: snap
